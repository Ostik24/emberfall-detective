{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/remind_evals.sh" }
        ]
      }
    ]
  },
  "permissions": {
    "deny": ["Read(./.env)", "Bash(export ANTHROPIC_API_KEY*)"]
  }
}
